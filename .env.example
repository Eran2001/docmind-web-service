# Base URL of the API (docmind-api-service). Every request goes here (the mock is the exception, see below).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# true = the in-browser mock answers everything EXCEPT the endpoints listed in src/lib/api/real-routes.ts
#        (register, login and /auth/me are real). Turn it off once the whole API exists.
NEXT_PUBLIC_USE_MOCKS=true

# true = show the TanStack Query devtools button in dev (off by default).
NEXT_PUBLIC_QUERY_DEVTOOLS=false
