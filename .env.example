# Base URL of the API (docmind-api-service). Every request goes here.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public address of the web app (for share-link previews). Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://docmind.example.com

# true = show the TanStack Query devtools button in dev (off by default).
NEXT_PUBLIC_QUERY_DEVTOOLS=false
