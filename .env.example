# Base URL of the Node API (spec section 12). Only used when mocks are off.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# true = serve every API call from the in-browser mock (no backend needed).
NEXT_PUBLIC_USE_MOCKS=true

# true = show the TanStack Query devtools button in dev (off by default).
NEXT_PUBLIC_QUERY_DEVTOOLS=false
